            'Now €47.20 instead of €59.00': 'Maintenant à 47,20 € au lieu de 59,00 €',
            'Now €70.80 instead of €88.50': 'Maintenant à 70,80 € au lieu de 88,50 €',
            'Now €94.40 instead of €118.00': 'Maintenant à 94,40 € au lieu de 118,00 €',
          },
        };

        const localeTexts = translations[locale];
        if (!localeTexts) return;

        const elements = document.querySelectorAll('body *:not(script):not(style)');

        elements.forEach((el) => {
          if (el.children.length === 0 && el.textContent.trim()) {
            let text = el.textContent.trim();
            Object.keys(localeTexts).forEach((original) => {
              if (text.includes(original)) {
                el.textContent = text.replace(original, localeTexts[original]);
              }
            });
          }
        });
      }

      function setupAppstleTranslationObserver() {
        const observer = new MutationObserver(() => {
          translateAppstleText();
        });

        observer.observe(document.body, {
          childList: true,
          subtree: true,
        });

        setTimeout(translateAppstleText, 1000);
      }

      document.addEventListener('DOMContentLoaded', () => {
        setupAppstleTranslationObserver();
      });

      document.addEventListener('shopify:section:load', () => {
        setupAppstleTranslationObserver();
      });

      document.addEventListener('turbo:load', () => {
        setupAppstleTranslationObserver();
      });
    </script>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        function updateStrikePriceVisibility() {
          const activeOption = document.querySelector('.appstle_subscription_wrapper_option.appstle-active-option');
          const regularPrice = document.querySelector('span[data-regular-price]');
          const strikePrice = document.querySelector('.strike.ml1');

          if (regularPrice) {
            if (activeOption && activeOption.textContent.includes('Subscribe')) {
              regularPrice.style.textDecoration = 'line-through';
            } else {
              regularPrice.style.textDecoration = 'none';
            }
          }

          if (strikePrice) {
            if (activeOption && activeOption.textContent.includes('Subscribe')) {
              strikePrice.style.display = 'none';
            } else {
              strikePrice.style.display = '';
            }
          }
        }

        const observer = new MutationObserver(() => {
          const appstleLoaded = document.querySelector('.appstle_subscription_wrapper_option');

          if (appstleLoaded) {
            updateStrikePriceVisibility();

            document.querySelectorAll('.appstle_subscription_wrapper_option').forEach((option) => {
              option.addEventListener('click', function () {
                setTimeout(updateStrikePriceVisibility, 100);
              });
            });

            const wrapper = document.querySelector('.appstle_subscription_wrapper');
            if (wrapper) {
              const subObserver = new MutationObserver(() => {
                updateStrikePriceVisibility();
              });

              subObserver.observe(wrapper, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ['class'],
              });
            }

            observer.disconnect();
          }
        });

        observer.observe(document.body, { childList: true, subtree: true });
      });
    </script>

