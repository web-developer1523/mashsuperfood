  <script>
    $(document).ready(function () {

      function updatePrice() {
        
        let discountedPrice = null;
        let originalPrice = null;
        let currency = '€';
  
        console.log("🔥 updatePrice() called");
  
        // -------------------------------------------
        // 1️⃣ Detect which option is selected
        // -------------------------------------------
        const selectedSellingPlan = document.querySelector('input[name="selling_plan"]:checked');
        
        // Check if Buy Once is selected (empty selling_plan value)
        const isBuyOnceSelected = selectedSellingPlan && selectedSellingPlan.value === "";
        
        // Check if Subscription is selected (has selling_plan value)
        const isSubscriptionSelected = selectedSellingPlan && selectedSellingPlan.value === "691310330183";
        
        // Check if Pack option is selected (custom packs with empty selling_plan but in pack container)
        const isPackSelected = selectedSellingPlan && selectedSellingPlan.closest(".single_pack_option");
  
        console.log("Buy Once Selected:", isBuyOnceSelected);
        console.log("Subscription Selected:", isSubscriptionSelected);
        console.log("Pack Selected:", isPackSelected);
  
        // -------------------------------------------
        // 2️⃣ Handle BUY ONCE pricing
        // -------------------------------------------
        if (isBuyOnceSelected && !isPackSelected) {
          const buyOnceContainer = document.querySelector('.appstle_one_time_price_wrapper');
          if (buyOnceContainer) {
            const priceEl = buyOnceContainer.querySelector('.appstle_subscription_amount.transcy-money');
            if (priceEl) {
              let raw = priceEl.textContent.trim();
              discountedPrice = parsePrice(raw);
              console.log("Buy Once price:", discountedPrice);
            }
          }
        }
  
        // -------------------------------------------
        // 3️⃣ Handle SUBSCRIPTION pricing
        // -------------------------------------------
        if (isSubscriptionSelected) {
          const subscriptionContainer = document.querySelector('.appstle_subscription_amount_wrapper');
          if (subscriptionContainer) {
            const discountedEl = subscriptionContainer.querySelector('.appstle_subscription_amount.transcy-money');
            const originalEl = subscriptionContainer.querySelector('.appstle_subscription_compare_amount.transcy-money');
            
            if (discountedEl) {
              let raw = discountedEl.textContent.trim();
              discountedPrice = parsePrice(raw);
              console.log("Subscription discounted price:", discountedPrice);
            }
            
            if (originalEl) {
              let raw = originalEl.textContent.trim();
              originalPrice = parsePrice(raw);
              console.log("Subscription original price:", originalPrice);
            }
          }
        }
  
        // -------------------------------------------
        // 4️⃣ Handle PACK pricing
        // -------------------------------------------
        if (isPackSelected) {
          const packWrapper = selectedSellingPlan.closest(".single_pack_option");
          if (packWrapper) {
            const labelText = packWrapper.innerText.replace(/\n+/g, " ").trim();
            console.log(labelText + "   (normalized)");
          
            // Extract discounted price
            const discountedMatch = labelText.match(
              /(Now|Jetzt|Nu|Ab|À|A)[^€]*€\s*([\d.,]+)/i
            );
          
            if (discountedMatch) {
              discountedPrice = parsePrice(discountedMatch[2]);
              console.log("Pack discounted price:", discountedPrice);
            }
          
            // Extract original price
            const originalMatch = labelText.match(
              /(instead of|statt|plaats van|au lieu de|invece di)[^€]*€\s*([\d.,]+)/i
            );
          
            if (originalMatch) {
              originalPrice = parsePrice(originalMatch[2]);
              console.log("Pack original price:", originalPrice);
            }
          }          
        }
  
        // -------------------------------------------
        // 5️⃣ Fallback: Get currency from any price element
        // -------------------------------------------
        const priceElements = document.querySelectorAll([
          '.appstle_subscription_amount.transcy-money',
          '.single_pack_option',
          '.product__price-value',
          'button.ajax-submit.js-ajax-submit span[data-regular-price]'
        ].join(','));
  
        for (let el of priceElements) {
          const text = el.textContent || el.innerText;
          const currencyMatch = text.match(/[^\d\s.,]+/);
          if (currencyMatch) {
            currency = currencyMatch[0];
            break;
          }
        }
  
        console.log("Detected currency:", currency);
  
        // -------------------------------------------
        // 6️⃣ Update button prices - SPECIFIC TO ADD TO CART BUTTON
        // -------------------------------------------
        const addToCartButton = document.querySelector("button.ajax-submit.js-ajax-submit");
        
        if (addToCartButton) {
          const btnPriceEl = addToCartButton.querySelector("span[data-regular-price]");
          const btnCompareEl = addToCartButton.querySelector("span[data-compare-price]");
          const btnCompareText = addToCartButton.querySelector("span[data-compare-text]");
  
          // Update discounted price
          if (discountedPrice && btnPriceEl) {
            const formattedPrice = formatPrice(discountedPrice, currency);
            btnPriceEl.textContent = formattedPrice;
            console.log("Updated add to cart button price:", formattedPrice);
          }
  
          // Update compare price (show/hide based on whether original price exists)
          if (btnCompareEl && btnCompareText) {
            if (originalPrice) {
              const formattedCompare = formatPrice(originalPrice, currency);
              btnCompareEl.textContent = formattedCompare;
              btnCompareText.classList.remove("hide");
              btnCompareEl.classList.remove("hide");
              console.log("Updated add to cart compare price:", formattedCompare);
            } else {
              btnCompareText.classList.add("hide");
              btnCompareEl.classList.add("hide");
            }
          }
        } else {
          console.log("Add to cart button not found");
        }
  
        return discountedPrice != null;
      }
  
      // Helper function to parse prices in any currency format
      function parsePrice(priceString) {
        if (!priceString) return null;
        
        // Remove all non-numeric characters except dots and commas
        let cleaned = priceString.replace(/[^\d,.]/g, '').trim();
        
        // Handle European format (1.000,00) vs US format (1,000.00)
        if (cleaned.includes(',') && cleaned.includes('.')) {
          // If both exist, comma is likely decimal separator (European)
          if (cleaned.lastIndexOf(',') > cleaned.lastIndexOf('.')) {
            cleaned = cleaned.replace(/\./g, '').replace(',', '.');
          } else {
            // Comma is thousands separator
            cleaned = cleaned.replace(/,/g, '');
          }
        } else if (cleaned.includes(',')) {
          // Check if comma is used as decimal separator
          const parts = cleaned.split(',');
          if (parts[1] && parts[1].length === 2) {
            // Likely decimal separator (e.g., 28,99)
            cleaned = cleaned.replace(',', '.');
          } else {
            // Likely thousands separator (e.g., 1,000)
            cleaned = cleaned.replace(/,/g, '');
          }
        }
        
        const price = parseFloat(cleaned);
        return isNaN(price) ? null : price;
      }
  
      // Helper function to format price with currency symbol
      function formatPrice(price, currency) {
        // Format with 2 decimal places and proper decimal separator based on currency
        let formattedPrice;
        
        // For European currencies, use comma as decimal separator
        if (['€', '£', 'kr', 'zł', 'CHF', 'DKK', 'SEK', 'NOK'].includes(currency)) {
          formattedPrice = price.toFixed(2).replace('.', ',');
        } else {
          // For others, use dot as decimal separator
          formattedPrice = price.toFixed(2);
        }
        
        return `${currency}${formattedPrice}`;
      }
  
      // -------------------------------------------
      // Wait for widgets to load and initialize
      // -------------------------------------------
      function runWhenReady(callback) {
        function elementsExist() {
          return (
            document.querySelector(".appstle_subscription_wrapper") ||
            document.querySelector(".single_pack_option") ||
            document.querySelector('button.ajax-submit.js-ajax-submit')
          );
        }
  
        if (elementsExist()) {
          callback();
          return;
        }
  
        const observer = new MutationObserver(() => {
          if (elementsExist()) {
            observer.disconnect();
            callback();
          }
        });
  
        observer.observe(document.body, { childList: true, subtree: true });
  
        setTimeout(() => {
          observer.disconnect();
          callback();
        }, 1000);
      }
  
      // Initialize
      runWhenReady(() => {
        console.log("🔥 Initial price update after widgets load");
        // Set Buy Once as default selection - MORE RELIABLE APPROACH
        setTimeout(() => {
          const buyOnceInput = document.querySelector('.appstle_one_time_details_wrapper input[value=""]');
          if (buyOnceInput) {
            // Method 1: Directly check the radio button
            buyOnceInput.checked = true;
            
            // Method 2: Trigger both change and click events
            buyOnceInput.dispatchEvent(new Event('change', { bubbles: true }));
            
            // Method 3: Also click the label for visual feedback
            const buyOnceLabel = document.querySelector('.appstle_one_time_details_wrapper label');
            if (buyOnceLabel) {
              buyOnceLabel.click();
            }
            
            console.log("✅ Buy Once option set as default");
          }
        }, 1500);
        updatePrice();
        
        // Add event listeners for all relevant changes
        document.addEventListener("change", (e) => {
          if (e.target.name === "selling_plan") {
            console.log("🔄 Selling plan changed:", e.target.value);
            updatePrice();
          }
        });
  
        // Also listen for clicks on pack options (since they use hidden radios)
        document.addEventListener("click", (e) => {
          if (e.target.closest(".single_pack_option")) {
            setTimeout(() => {
              console.log("🔄 Pack option clicked");
              updatePrice();
            }, 50);
          }
        });
  
        // Listen for Appstle subscription changes
        const appstleContainer = document.querySelector('.appstle_subscription_wrapper');
        if (appstleContainer) {
          appstleContainer.addEventListener('click', (e) => {
            setTimeout(() => {
              console.log("🔄 Appstle option clicked");
              updatePrice();
            }, 50);
          });
        }
      });
  
      // Backup interval for safety
      let tries = 0;
      const interval = setInterval(() => {
        tries++;
        const ok = updatePrice();
        if (ok || tries > 10) {
          clearInterval(interval);
          console.log("✅ Price updater initialized successfully");
        }
      }, 500);
      
    });
  </script>
