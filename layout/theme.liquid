function waitForAppstleHTML() {
  const target = document.body;

  const observer = new MutationObserver(() => {
      const items = document.querySelectorAll(
          '.appstle_subscription_wrapper_option .single_pack_option label div span[style*="font-size"]:not(.processed-for-saving)'
      );

      if (items.length > 0) {
          observer.disconnect(); // stop observing after found
          addSavingText(items);
      }
  });

  observer.observe(target, { childList: true, subtree: true });
}

function addSavingText(items) {
  items.forEach((spanEl) => {
      let txt = spanEl.textContent.trim();  
      const prices = txt.match(/€\s?([\d\.,]+).*€\s?([\d\.,]+)/);

      if (prices) {
          let nowPrice = parseFloat(prices[1].replace(',', '.'));
          let oldPrice = parseFloat(prices[2].replace(',', '.'));
          let savings = (oldPrice - nowPrice).toFixed(2).replace('.', ',');

          // Insert AFTER this span
          spanEl.insertAdjacentHTML(
              'afterend',
              `<p class="saving-text">
                  (${window.config.save_text} €${savings})
              </p>`
          );
      }

      // Mark processed so it never repeats
      spanEl.classList.add('processed-for-saving');
  });
}
document.addEventListener("DOMContentLoaded", waitForAppstleHTML);

