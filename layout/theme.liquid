    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="{{ 'slick.min.js' | asset_url }}" defer></script>
  </head>

  <body
    id="{{ page_title | handle }}"
    class="template-{{ template.name | handle }} js-slideout-toggle-wrapper js-modal-toggle-wrapper {{ settings.scroll_animation }} {{ settings.text_animation }} section-fade-in buttons--{{ settings.button_animation }}"
  >
    {% render 'snip-skip-link' %}

    {% if settings.enable_age_verify %}
      {% render 'snip-age-verification' %}
    {% endif %}

    {%- if template == 'index' -%}
      <h1 class="visually-hidden">{{ page_title }}</h1>
    {%- endif -%}

    <div class="js-slideout-overlay site-overlay"></div>
    <div class="js-modal-overlay site-overlay"></div>

    {% sections 'mobile-navigation-group' %}

    <main id="main-content" class="site-wrap" role="main" tabindex="-1">
      {% sections 'header-group' %}

      <div class="page-wrap {% unless template == 'index' %}mb10{% endunless %}">
        {{ content_for_layout }}
      </div>

      {% sections 'footer-group' %}
    </main>

    {% section 'mailing-popup' %}
    {% section 'quickshop' %}

    {%- if settings.cart_type == 'drawer' -%}
      <aside
        popover="auto"
        class="slideout slideout__drawer-right mini-cart"
        data-wau-slideout="ajax-cart"
        id="slideout-ajax-cart"
      >
        {% render 'cart-mini' %}
      </aside>
    {% elsif settings.cart_type == 'modal_cart' %}
      <div
        popover="auto"
        class="modal__container"
        data-wau-modal="ajax-cart"
        id="modal-ajax-cart"
      >
        <div class="modal__inner-wrapper">
          {% render 'cart-mini' %}
        </div>
      </div>
    {%- endif -%}

    {% render 'cart-config' %}

    <script type="text/javascript">
      var jsAssets = {
        "zoom": {{ 'vendor-zoom.js' | asset_url | json }},
        "flickity": {{ 'vendor-flickity.js' | asset_url | json }},
        "product": {{ 'product.js' | asset_url | json }},
        "productModel": {{ 'product-model.js' | asset_url | json }},
        "productVideo": {{ 'product-video.js' | asset_url | json }},
        "productPickupAvailability": {{ 'pickup-availability.js' | asset_url | json }},
        "productComplementaryProducts": {{ 'complementary-products.js' | asset_url | json }}
      }
    </script>

    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

    {%- if settings.product_grid_video -%}
      <script src="{{ 'vendor-video.js' | asset_url }}" defer></script>
    {%- endif -%}

    {%- render 'snip-photoswipe' -%}

    <aside
      class="slideout slideout__drawer-right"
      data-wau-slideout="store-availability"
      id="slideout-store-availability"
    ></aside>

    <wau-popover-loader
      data-asset-url="{{ 'vendor-popover-polyfill.js' | asset_url }}"
      data-css-class="popover"
    ></wau-popover-loader>
    <script>
      function waitForElement(selector, callback) {
        const element = document.querySelector(selector);
        if (element) {
          callback(element);
        } else {
          setTimeout(() => waitForElement(selector, callback), 100);
        }
      }
    
      function formatCurrency(value) {
        return `€${value.toFixed(2).replace('.', ',')}`;
      }
    
      function parsePrice(priceString) {
        // Remove currency symbol and convert to number
        return parseFloat(priceString.replace(/[^0-9.,]/g, '').replace(',', '.'));
      }
    
      const lang = document.documentElement.lang || 'en';
      const translations = {
        en: {
          discountOff: 'off',
          nowInsteadOf: 'Now {regular} instead of {compare}',
          packLabels: {
            pack2: 'Get 2nd bag at',
            pack3: 'Get 3rd bag at',
            pack4: 'Get 4th bag at',
          }
        },
        de: {
          discountOff: 'Rabatt',
          nowInsteadOf: 'Jetzt {regular} statt {compare}',
          packLabels: {
            pack2: '2. Beutel erhalten für',
            pack3: '3. Beutel erhalten für',
            pack4: '4. Beutel erhalten für',
          }
        },
        nl: {
          discountOff: 'korting',
          nowInsteadOf: 'Nu {regular} in plaats van {compare}',
          packLabels: {
            pack2: '2e zak krijgen voor',
            pack3: '3e zak krijgen voor',
            pack4: '4e zak krijgen voor',
          }
        },
        fr: {
          discountOff: 'de réduction',
          nowInsteadOf: 'Maintenant {regular} au lieu de {compare}',
          packLabels: {
            pack2: 'Obtenez le 2ème sac à',
            pack3: 'Obtenez le 3ème sac à',
            pack4: 'Obtenez le 4ème sac à',
          }
        }
      };
    
      waitForElement('.appstle_subscription_wrapper', (container) => {
        // Method 1: Try to get prices from data attributes (most reliable)
        function getProductPrices() {
          let regularPrice, comparePrice;
          
          // Method 1A: Try to get from regular price element
          const regularPriceEl = document.querySelector('[data-regular-price], .price--regular .money, .product__price .price-item--regular');
          if (regularPriceEl) {
            regularPrice = parsePrice(regularPriceEl.textContent);
          }
          
          // Method 1B: Try to get from compare price element
          const comparePriceEl = document.querySelector('[data-compare-price], .price--compare .money, .product__price .price-item--compare');
          if (comparePriceEl) {
            comparePrice = parsePrice(comparePriceEl.textContent);
          }
          
          // Method 2: Try to get from Shopify product JSON (if available)
          if (!regularPrice || !comparePrice) {
            const productJsonEl = document.querySelector('[data-product-json]');
            if (productJsonEl) {
              try {
                const productData = JSON.parse(productJsonEl.textContent);
                regularPrice = productData.price / 100; // Shopify stores price in cents
                comparePrice = productData.compare_at_price ? productData.compare_at_price / 100 : regularPrice;
              } catch (e) {
                console.log('Could not parse product JSON');
              }
            }
          }
          
          // Method 3: Try to get from variant data
          if (!regularPrice || !comparePrice) {
            const variantSelect = document.querySelector('[name="id"], select[name="id"]');
            if (variantSelect) {
              const variantId = variantSelect.value;
              const variantOption = variantSelect.querySelector(`option[value="${variantId}"]`);
              if (variantOption) {
                const dataPrice = variantOption.getAttribute('data-price');
                const dataComparePrice = variantOption.getAttribute('data-compare-price');
                
                if (dataPrice) regularPrice = parseFloat(dataPrice) / 100;
                if (dataComparePrice) comparePrice = parseFloat(dataComparePrice) / 100;
              }
            }
          }
          
          // Method 4: Fallback to window.product object (common in Shopify themes)
          if (!regularPrice && window.product) {
            regularPrice = window.product.price / 100;
            comparePrice = window.product.compare_at_price ? window.product.compare_at_price / 100 : regularPrice;
          }
          
          // Method 5: Last resort - try to extract from any price element
          if (!regularPrice) {
            const anyPrice = document.querySelector('.price, .product__price, .money');
            if (anyPrice) {
              const priceText = anyPrice.textContent;
              const prices = priceText.match(/[\d,.]+/g);
              if (prices && prices.length > 0) {
                regularPrice = parsePrice(prices[0]);
                comparePrice = prices.length > 1 ? parsePrice(prices[1]) : regularPrice;
              }
            }
          }
          
          // Final fallback to your original values if nothing found
          return {
            regularPrice: regularPrice || 29.50,
            comparePrice: comparePrice || 39.95
          };
        }
        
        const prices = getProductPrices();
        const baseRegularPrice = prices.regularPrice;
        const baseComparePrice = prices.comparePrice || baseRegularPrice;
    
        console.log('Detected prices:', { baseRegularPrice, baseComparePrice });
    
        const discountSettings = window.bundleDiscounts || {};
        const pack2Discount = discountSettings.pack2 || 15;
        const pack3Discount = discountSettings.pack3 || 20;
        const pack4Discount = discountSettings.pack4 || 25;
    
        const packs = [
          {
            id: 'pack2',
            labelKey: 'pack2',
            qty: 2,
            discount: `${pack2Discount}%`,
            discountRate: (100 - pack2Discount) / 100,
            default: true
          },
          {
            id: 'pack3',
            labelKey: 'pack3',
            qty: 3,
            discount: `${pack3Discount}%`,
            discountRate: (100 - pack3Discount) / 100,
            default: false
          },
          {
            id: 'pack4',
            labelKey: 'pack4',
            qty: 4,
            discount: `${pack4Discount}%`,
            discountRate: (100 - pack4Discount) / 100,
            default: false
          }
        ].map(pack => {
          return {
            ...pack,
            regular: baseRegularPrice * pack.qty * pack.discountRate,
            compare: baseComparePrice * pack.qty * pack.discountRate,
            originalRegular: baseRegularPrice * pack.qty,
            originalCompare: baseComparePrice * pack.qty
          };
        });
    
        const mainWrapper = document.createElement('div');
        mainWrapper.className = 'appstle_subscription_wrapper_option';
        Object.assign(mainWrapper.style, {
          border: '1px solid #000',
          marginTop: '15px',
          borderRadius: '15px',
          padding: '16px',
          display: 'flex',
          flexDirection: 'column',
          gap: '10px'
        });
    
        packs.forEach(pack => {
          const option = document.createElement('div');
          option.className = 'single_pack_option';
          Object.assign(option.style, {
            display: 'flex',
            alignItems: 'center',
            border: '1px solid #ccc',
            padding: '10px',
            borderRadius: '10px',
            cursor: 'pointer'
          });
    
          const label = translations[lang]?.packLabels?.[pack.labelKey] || translations.en.packLabels[pack.labelKey];
          const discountLabel = translations[lang]?.discountOff || translations.en.discountOff;
          const priceText = (translations[lang]?.nowInsteadOf || translations.en.nowInsteadOf)
            .replace('{regular}', formatCurrency(pack.regular))
            .replace('{compare}', formatCurrency(pack.originalRegular));
    
          option.innerHTML = `
            <div class="appstle_subscription_radio_wrapper" style="display:flex; align-items:center;">
              <input type="radio" id="${pack.id}" name="selling_plan" value="" style="display:none;" ${pack.default ? 'checked' : ''} />
              <label for="${pack.id}" class="appstle_radio_label flex" style="cursor:pointer; display:flex; align-items:center;">
                <span class="appstle_circle" style="display:inline-block; width:16px; height:16px; border:2px solid black; border-radius:50%; position:relative; margin-right:10px;">
                  <span class="appstle_dot" style="display:${pack.default ? 'block' : 'none'}; width:8px; height:8px; background:black; border-radius:50%; position:absolute; top:2px; left:2px;"></span>
                </span>
                <div style="flex:1;">
                  ${label} <span style="color:red;">${pack.discount} ${discountLabel}</span><br>
                  <span style="font-size: 0.9em;">${priceText}</span>
                </div>
              </label>
            </div>
          `;
          mainWrapper.appendChild(option);
        });
    
        container.appendChild(mainWrapper);
    
        waitForElement('input[name="quantity"]', (hiddenQtyInput) => {
          // Handle variant changes to update prices dynamically
          const variantSelect = document.querySelector('[name="id"], select[name="id"]');
          if (variantSelect) {
            variantSelect.addEventListener('change', () => {
              // Re-fetch prices when variant changes
              const newPrices = getProductPrices();
              baseRegularPrice = newPrices.regularPrice;
              baseComparePrice = newPrices.comparePrice || baseRegularPrice;
              
              // Update pack prices
              packs.forEach(pack => {
                pack.regular = baseRegularPrice * pack.qty * pack.discountRate;
                pack.compare = baseComparePrice * pack.qty * pack.discountRate;
                pack.originalRegular = baseRegularPrice * pack.qty;
                pack.originalCompare = baseComparePrice * pack.qty;
                
                // Update displayed prices
                const optionEl = document.getElementById(pack.id);
                if (optionEl) {
                  const priceText = (translations[lang]?.nowInsteadOf || translations.en.nowInsteadOf)
                    .replace('{regular}', formatCurrency(pack.regular))
                    .replace('{compare}', formatCurrency(pack.originalRegular));
                  
                  const priceSpan = optionEl.closest('.single_pack_option').querySelector('span[style*="font-size: 0.9em"]');
                  if (priceSpan) {
                    priceSpan.textContent = priceText;
                  }
                }
              });
            });
          }
        });
      });
    
      document.addEventListener("DOMContentLoaded", function () {
        function initPackRadios() {
          const radios = document.querySelectorAll('input[name="selling_plan"]');
          const qtyInput = document.querySelector(".product__quantity input.product__quantity-input");
    
          if (!radios.length || !qtyInput) {
            setTimeout(initPackRadios, 300);
            return;
          }
    
          function updateQuantity(radio) {
            if (radio.id === "pack2") {
              qtyInput.value = 2;
            } else if (radio.id === "pack3") {
              qtyInput.value = 3;
            } else if (radio.id === "pack4") {
              qtyInput.value = 4;
            } else {
              qtyInput.value = 1;
            }
    
            qtyInput.dispatchEvent(new Event("input", { bubbles: true }));
            qtyInput.dispatchEvent(new Event("change", { bubbles: true }));
          }
    
          const checkedRadio = document.querySelector('input[name="selling_plan"]:checked');
          if (checkedRadio) {
            updateQuantity(checkedRadio);
          }
    
          radios.forEach(radio => {
            radio.addEventListener("change", function () {
              updateQuantity(this);
            });
          });
        }
    
        initPackRadios();
      });
    </script>
