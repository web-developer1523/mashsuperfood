  (function () {

    function parsePrice(text) {
      if (!text) return NaN;
      text = text.trim();
      const cleaned = text.replace(/[^\d.,]/g, "");
      if (!cleaned) return NaN;
      const lastDot = cleaned.lastIndexOf(".");
      const lastComma = cleaned.lastIndexOf(",");
      let normalized;
  
      if (lastComma > lastDot) {
        normalized = cleaned.replace(/\./g, "").replace(",", ".");
      } else if (lastDot > lastComma) {
        normalized = cleaned.replace(/,/g, "");
      } else {
        normalized = cleaned.includes(",") ? cleaned.replace(",", ".") : cleaned.replace(/,/g, "");
      }
  
      return parseFloat(normalized);
    }
  
    function currencySymbol(t) {
      const m = t.match(/[^0-9\s\.,]+/);
      return m ? m[0] : "";
    }
  
    function updateOne(option) {
      const saleEl = option.querySelector(".appstle_subscription_amount.transcy-money");
      const compEl = option.querySelector(".appstle_subscription_compare_amount.transcy-money");
      const badge = option.querySelector(".appstle-save-badge");
  
      if (!saleEl || !compEl || !badge) return;
  
      const sale = parsePrice(saleEl.textContent);
      const comp = parsePrice(compEl.textContent);
      if (!isFinite(sale) || !isFinite(comp) || comp <= sale) return;
  
      const cur = currencySymbol(saleEl.textContent) || currencySymbol(compEl.textContent);
      const save = (comp - sale).toFixed(2);
  
      // REMOVE old you-save
      const old = option.querySelector(".you-save");
      if (old) old.remove();
  
      // INSERT AFTER badge
      const p = document.createElement("p");
      p.className = "you-save";
      p.textContent = `(${window.config.save_text} ${cur}${save})`;
      badge.insertAdjacentElement("afterend", p);
    }
  
    function updateAll() {
      document.querySelectorAll(".appstle_subscription_wrapper_option").forEach(updateOne);
    }
  
    // run shortly until everything loads
    let tries = 0;
    function boot() {
      tries++;
      updateAll();
      if (tries < 20) setTimeout(boot, 120);
    }
  
    boot();
  
    // currency updates
    document.addEventListener("app:currency:converted", updateAll);
  
  })();

