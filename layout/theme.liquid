<script>
  document.addEventListener("DOMContentLoaded", function () {
  
    const lang = document.documentElement.lang.toLowerCase();
    const CLICK_SELECTOR = '.appstle_subscription_wrapper_option.appstle_include_dropdown';
    const TEXT_SELECTOR =
      '.appstle_subscription_wrapper_option.appstle_include_dropdown input + label span.appstle_subscribe_save_text';
  
    function getTextByLang() {
      if (lang.startsWith("de")) return "Abonnieren";
      if (lang.startsWith("nl")) return "Abonneren";
      return "Subscribe";
    }
  
    function updateText() {
      const target = document.querySelector(TEXT_SELECTOR);
      if (target) {
        target.textContent = getTextByLang();
      }
    }
  
    /* ---------- 1️⃣ INITIAL LOAD (App HTML) ---------- */
    const observer = new MutationObserver(function () {
      const target = document.querySelector(TEXT_SELECTOR);
      if (target) {
        updateText();
        observer.disconnect(); // stop after first successful update
      }
    });
  
    observer.observe(document.body, {
      childList: true,
      subtree: true
    });
  
    /* ---------- 2️⃣ ON CLICK (App re-renders) ---------- */
    document.addEventListener("click", function (e) {
      if (e.target.closest(CLICK_SELECTOR)) {
        setTimeout(updateText, 100); // wait for Appstle to re-render
      }
    });
  
  });
  </script>
  
