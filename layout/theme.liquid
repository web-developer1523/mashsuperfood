  (function(){
    // tiny helper: parse human price to number (supports 1.234,56 and 1,234.56)
    function parsePrice(text){
      if(!text) return NaN;
      text = text.trim();
      // remove non-number but keep . and ,
      const cleaned = text.replace(/[^\d\.,]/g, '');
      if(!cleaned) return NaN;
      const lastDot = cleaned.lastIndexOf('.');
      const lastComma = cleaned.lastIndexOf(',');
      // decide decimal separator by last occurrence
      let normalized;
      if(lastComma > lastDot){
        // comma is decimal (e.g. 1.234,56 or 12,34)
        normalized = cleaned.replace(/\./g,'').replace(',', '.');
      } else if(lastDot > lastComma){
        // dot is decimal (e.g. 1,234.56)
        normalized = cleaned.replace(/,/g,'');
      } else {
        // only one of them or none — assume dot decimal if present else comma decimal if present
        if(cleaned.indexOf(',') !== -1 && cleaned.indexOf('.') === -1){
          normalized = cleaned.replace(',', '.');
        } else {
          normalized = cleaned.replace(/,/g,'');
        }
      }
      return parseFloat(normalized);
    }
  
    // try multiple selectors so it's robust
    function findPriceEls(){
      const regular = document.querySelector('[data-regular-price]') ||
                      // fallback: first non-strike span in price block
                      document.querySelector('.product__price-value span:not(.strike)');
      const compare = document.querySelector('[data-compare-price]') ||
                      document.querySelector('.product__price-value .strike') ||
                      document.querySelector('.product__price-value .strike.ml1');
      return {regular, compare};
    }
  
    // currency symbol detection: prefer symbol from compare, else regular
    function detectCurrencySymbol(text){
      if(!text) return '';
      // find first non-digit character sequence (common for currency symbols)
      const m = text.match(/[^0-9\s\.,]+/);
      return m ? m[0] : '';
    }
  
    function updateSavingsOnce(){
      const {regular, compare} = findPriceEls();
      if(!regular || !compare) return false;
  
      const rText = regular.textContent || regular.innerText || '';
      const cText = compare.textContent || compare.innerText || '';
  
      const currency = detectCurrencySymbol(cText) || detectCurrencySymbol(rText) || '';
  
      const rVal = parsePrice(rText);
      const cVal = parsePrice(cText);
  
      if(!isFinite(rVal) || !isFinite(cVal) || cVal <= rVal) return false;
  
      const savings = (cVal - rVal).toFixed(2);
  
      // find every target (in case you have multiple subscription labels)
      const targets = document.querySelectorAll('.appstle_subscription_wrapper_option input + label .appstle_one_time_text');
  
      if(!targets || !targets.length) return false;
  
      targets.forEach(t => {
        // remove old node
        const old = t.querySelector('.you-save');
        if(old) old.remove();
        // append new node (use textContent to avoid HTML injection)
        const p = document.createElement('p');
        p.className = 'you-save';
        p.textContent = `(${window.config.save_text} ${currency}${savings})`;
        t.appendChild(p);
      });
  
      return true;
    }
  
    // Lightweight waiter: try to update for up to ~3 seconds (fast), then stop.
    let attempts = 0;
    function tryUntilSuccess(){
      attempts++;
      const ok = updateSavingsOnce();
      if(ok) return;
      if(attempts > 30) return; // ~30 * 100ms = 3s max
      setTimeout(tryUntilSuccess, 100);
    }
  
    // start
    tryUntilSuccess();
  
    // also respond to common currency update events if present (safe no-op)
    document.addEventListener('app:currency:converted', tryUntilSuccess);
    document.addEventListener('currency:converted', tryUntilSuccess);
    document.addEventListener('appstle:subscription:updated', tryUntilSuccess);
  })();

