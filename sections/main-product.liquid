<script>
$(document).ready(function() {
  var checkInterval = setInterval(function() {
    var $reviewElement = $('.alr-wh-rating-total-review');
    var reviews = $reviewElement.text().trim();
    
    var averageReviews = $('.alr-wh-rating-star-average').text();

    // If the element exists and has text
    if ($reviewElement.length && reviews !== "") {
      $('.total-reviews').text(' (' +reviews+ ')');
      $('.average-rating').text( averageReviews );
      console.log(averageReviews);
      clearInterval(checkInterval); // Stop checking once value is found
    }
  }, 100); // Check every 100ms
});
</script>
<script>
function translateBuyOnce() {
  var el = $('.appstle_one_time_text');
  if (el.length === 0) return false; // element not loaded yet

  var text = el.text();
  var buyOnce = text.split("(")[0].trim();

  if (buyOnce !== "Buy Once") return true; // already translated

  // Determine language
  var href = window.location.href;
  var replacement = null;

  if (href.includes("/de/")) replacement = "Einmal kaufen";           // German
  if (href.includes("/nl/")) replacement = "Eenmalige aankoop";       // Dutch

  if (replacement) {
    el.text(text.replace(buyOnce, replacement));
  }

  return true;
}

// Run once, if element not ready, wait for it
if (!translateBuyOnce()) {
  const observer = new MutationObserver(function () {
    if (translateBuyOnce()) {
      observer.disconnect();
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });
}

</script>
<script>
  function translateSubscribeText() {
  var el = $('.appstle_subscribe_save_text');
  if (el.length === 0) return false; // element not loaded yet

  var text = el.text().trim();
  if (text !== "Subscribe") return true; // already translated

  // Determine language
  var href = window.location.href;
  var replacement = null;

  if (href.includes("/de/")) replacement = "Abonnieren";         // German
  if (href.includes("/nl/")) replacement = "Abonneren";          // Dutch

  if (replacement) {
    el.text(replacement);
  }

  return true;
}

// Run once, if element not ready, observe DOM changes
if (!translateSubscribeText()) {
  const observer = new MutationObserver(function () {
    if (translateSubscribeText()) {
      observer.disconnect();
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });
}

</script>