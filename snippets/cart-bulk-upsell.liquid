{% comment %}
  Cart bulk discount upsell
  - Non-intrusive message shown near checkout on cart page/drawer
  - Uses global theme settings to select:
    - An upsell product that already has bulk/quantity discounts configured
    - Display-only tiers that mirror existing Shopify discount rules
  - Does NOT create or apply any new discounts; it only informs and nudges.
{% endcomment %}

{%- if cart.item_count > 0 -%}
  {%- if settings.upsell_bulk_collection != blank or settings.upsell_bulk_product != blank -%}
  {%- comment %}
    Support selecting an upsell collection (preferred) or fall back to a single product.
    If a collection is set, pick the first product from that collection.
  {%- endcomment -%}
  {%- assign upsell_rendered = '' -%}
  {%- assign upsell_collection = '' -%}
  {%- if settings.upsell_bulk_collection != blank -%}
    {%- assign upsell_collection = collections[settings.upsell_bulk_collection] -%}
  {%- endif -%}

  {%- comment %}
    Build tiers array from theme settings (shared for all rendered cards).
  {%- endcomment -%}
  {%- assign tiers_json = '' -%}
  {%- assign tier1_min = settings.upsell_bulk_tier1_min | default: 0 | plus: 0 -%}
  {%- assign tier1_disc = settings.upsell_bulk_tier1_discount | default: 0 | plus: 0 -%}
  {%- if tier1_min > 0 and tier1_disc > 0 -%}
    {%- assign fragment = '{"min_qty":' | append: tier1_min | append: ',"discount":' | append: tier1_disc | append: '}' -%}
    {%- assign tiers_json = fragment -%}
  {%- endif -%}
  {%- assign tier2_min = settings.upsell_bulk_tier2_min | default: 0 | plus: 0 -%}
  {%- assign tier2_disc = settings.upsell_bulk_tier2_discount | default: 0 | plus: 0 -%}
  {%- if tier2_min > 0 and tier2_disc > 0 -%}
    {%- assign fragment = '{"min_qty":' | append: tier2_min | append: ',"discount":' | append: tier2_disc | append: '}' -%}
    {%- if tiers_json != '' -%}
      {%- assign tiers_json = tiers_json | append: ',' | append: fragment -%}
    {%- else -%}
      {%- assign tiers_json = fragment -%}
    {%- endif -%}
  {%- endif -%}
  {%- assign tier3_min = settings.upsell_bulk_tier3_min | default: 0 | plus: 0 -%}
  {%- assign tier3_disc = settings.upsell_bulk_tier3_discount | default: 0 | plus: 0 -%}
  {%- if tier3_min > 0 and tier3_disc > 0 -%}
    {%- assign fragment = '{"min_qty":' | append: tier3_min | append: ',"discount":' | append: tier3_disc | append: '}' -%}
    {%- if tiers_json != '' -%}
      {%- assign tiers_json = tiers_json | append: ',' | append: fragment -%}
    {%- else -%}
      {%- assign tiers_json = fragment -%}
    {%- endif -%}
  {%- endif -%}

  {%- if cart.items and cart.items.size > 0 -%}
    {%- assign display_limit = settings.upsell_bulk_display_limit | default: 3 | plus: 0 -%}
    {%- assign layout = settings.upsell_bulk_layout | default: 'grid' -%}

    <div class="cart-bulk-upsell-wrapper cart-bulk-upsell--{{ layout }}">
      {%- for item in cart.items limit: display_limit -%}
        {%- assign upsell_variant_id = item.variant_id -%}
        {%- if upsell_variant_id and tiers_json != '' -%}
          <div
            class="cart-bulk-upsell js-cart-bulk-upsell"
            data-upsell-variant-id="{{ upsell_variant_id }}"
            data-tiers='[{{ tiers_json }}]'
          >
            <div class="cart-bulk-upsell__inner">
              <div class="cart-bulk-upsell__product">
                <div class="cart-bulk-upsell__image-wrapper">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'cart-bulk-upsell__image' }}
                  {%- elsif item.product and item.product.featured_image -%}
                    {{ item.product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'cart-bulk-upsell__image' }}
                  {%- else -%}
                    <span class="cart-bulk-upsell__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>
                  {%- endif -%}
                </div>
                <div class="cart-bulk-upsell__text">
                  <p class="cart-bulk-upsell__eyebrow">In your cart</p>
                  <p class="cart-bulk-upsell__title">
                    {{ item.product.title }}
                  </p>
                  <p class="cart-bulk-upsell__headline">
                    {{ settings.upsell_bulk_headline | default: 'Last-minute savings available' }}
                  </p>
                  <p class="cart-bulk-upsell__message js-cart-bulk-upsell-message" aria-live="polite"></p>
                </div>
              </div>

              <div class="cart-bulk-upsell__cta">
                <button
                  type="button"
                  class="cart-bulk-upsell__button js-cart-bulk-upsell-add"
                >
                  {{ settings.upsell_bulk_button_label | default: 'Add one more' }}
                </button>
              </div>
            </div>
          </div>
          {%- assign upsell_rendered = 'true' -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    {%- if settings.upsell_bulk_product != blank and tiers_json != '' -%}
      {%- assign upsell_product = all_products[settings.upsell_bulk_product] -%}
      {%- if upsell_product -%}
        {%- assign upsell_variant = upsell_product.selected_or_first_available_variant -%}
        <div
          class="cart-bulk-upsell js-cart-bulk-upsell"
          data-upsell-variant-id="{{ upsell_variant.id }}"
          data-tiers='[{{ tiers_json }}]'
        >
          <div class="cart-bulk-upsell__inner">
            <div class="cart-bulk-upsell__product">
              <div class="cart-bulk-upsell__image-wrapper">
                {%- if upsell_product.featured_image -%}
                  {{ upsell_product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'cart-bulk-upsell__image' }}
                {%- else -%}
                  <span class="cart-bulk-upsell__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>
                {%- endif -%}
              </div>
              <div class="cart-bulk-upsell__text">
                <p class="cart-bulk-upsell__eyebrow">Perfect with your order</p>
                <p class="cart-bulk-upsell__title">
                  {{ upsell_product.title }}
                </p>
                <p class="cart-bulk-upsell__headline">
                  {{ settings.upsell_bulk_headline | default: 'Last-minute savings available' }}
                </p>
                <p class="cart-bulk-upsell__message js-cart-bulk-upsell-message" aria-live="polite"></p>
              </div>
            </div>

            <div class="cart-bulk-upsell__cta">
              <button
                type="button"
                class="cart-bulk-upsell__button js-cart-bulk-upsell-add"
              >
                {{ settings.upsell_bulk_button_label | default: 'Add to cart' }}
              </button>
            </div>
          </div>
        </div>
        {%- assign upsell_rendered = 'true' -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
  {%- if upsell_rendered != '' and tiers_json != '' -%}
    <style>
      .cart-bulk-upsell {
        margin-top: 1rem;
        margin-bottom: 1rem;
        padding: 0.85rem 1.1rem;
        border-radius: 999px;
        border: 1px solid rgba(0, 0, 0, 0.04);
        background: rgba(0, 0, 0, 0.02);
        font-size: 0.9rem;
      }
      /* Use grid only before Slick initializes; Slick will handle layout after init */
      .cart-bulk-upsell-wrapper.cart-bulk-upsell--grid:not(.slick-initialized) {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        align-items: start;
      }
      .cart-bulk-upsell-wrapper.cart-bulk-upsell--list {
        display: block;
      }
      .cart-bulk-upsell {
        width: 100%;
      }
      .cart-bulk-upsell__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .cart-bulk-upsell__product {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 0;
      }
      .cart-bulk-upsell__image-wrapper {
        flex-shrink: 0;
        width: 56px;
        height: 56px;
        border-radius: 999px;
        overflow: hidden;
        background: #f4f1ea;
      }
      .cart-bulk-upsell__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .cart-bulk-upsell__text {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        min-width: 0;
      }
      .cart-bulk-upsell__eyebrow {
        margin: 0;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(0, 0, 0, 0.55);
      }
      .cart-bulk-upsell__title {
        margin: 0;
        font-size: 0.85rem;
        font-weight: 600;
        color: #111;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .cart-bulk-upsell__headline {
        margin: 0;
        font-size: 0.85rem;
        font-weight: 500;
      }
      .cart-bulk-upsell__message {
        margin: 0;
        color: rgba(0, 0, 0, 0.7);
        font-size: 0.8rem;
      }
      .cart-bulk-upsell__cta {
        flex-shrink: 0;
      }
      .cart-bulk-upsell__button {
        white-space: nowrap;
        {% comment %} padding: 0.5rem 1.2rem; {% endcomment %}
        border-radius: 999px;
        border: 0;
        background: #111;
        color: #fff;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
      }
      .cart-bulk-upsell__button:hover {
        background: #000;
      }
      .cart-bulk-upsell__savings-wrap {
        display: inline-block;
        margin-top: 0.25rem;
        color: #0b6b3a;
        font-weight: 600;
      }
      .cart-bulk-upsell__savings-total {
        color: #0b6b3a;
        margin-right: 0.35rem;
      }
      .cart-bulk-upsell__savings-per {
        color: rgba(0,0,0,0.65);
        font-weight: 500;
      }
      @media (max-width: 749px) {
        .cart-bulk-upsell {
          border-radius: 0.75rem;
        }
        .cart-bulk-upsell__inner {
          align-items: flex-start;
          flex-direction: column;
        }
        .cart-bulk-upsell__cta {
          width: 100%;
        }
        .cart-bulk-upsell__button {
          width: 100%;
          text-align: center;
        }
      }
    </style>
  {%- endif -%}
  {%- if layout == 'grid' -%}
    <script>
      (function () {
        // Poll for jQuery + Slick, initialize when available
        function initBulkSlickOnce() {
          var attempts = 0;
          var maxAttempts = 60; // ~6 seconds
          var delay = 100;

          function tryInit() {
            attempts++;
            if (typeof jQuery !== 'undefined' && jQuery.fn && typeof jQuery.fn.slick === 'function') {
              var $w = jQuery('.cart-bulk-upsell-wrapper.cart-bulk-upsell--grid');
              if ($w.length && !$w.hasClass('slick-initialized')) {
                $w.slick({
                  slidesToShow: 1,
                  slidesToScroll: 1,
                  arrows: true,
                  dots: false,
                  adaptiveHeight: true,
                  responsive: [
                    {
                      breakpoint: 750,
                      settings: {
                        slidesToShow: 1,
                        slidesToScroll: 1
                      }
                    }
                  ]
                });
              }
              return;
            }
            if (attempts < maxAttempts) {
              setTimeout(tryInit, delay);
            } else {
              if (window.console) console.warn('Cart bulk upsell: Slick not available.');
            }
          }

          tryInit();
        }

        document.addEventListener('DOMContentLoaded', initBulkSlickOnce);
        document.addEventListener('shopify:section:load', initBulkSlickOnce);
        document.addEventListener('shopify:section:select', initBulkSlickOnce);
        // Also try after a short delay for AJAX updates
        setTimeout(initBulkSlickOnce, 500);
      })();
    </script>
  {%- endif -%}
  <script>
    (function () {
      // Configuration
      var DISCOUNT_RATE = 0.20; // 20%
      var DISCOUNT_THRESHOLD = 3; // 3+ items unlock discount
      var moneyFormat = "{{ shop.money_format | escape }}";

      function formatMoney(cents) {
        if (typeof cents !== 'number') cents = Number(cents) || 0;
        var amount = (cents / 100).toFixed(2);
        if (moneyFormat && moneyFormat.indexOf('{{amount}}') !== -1) {
          return moneyFormat.replace('{{amount}}', amount);
        }
        // Fallback: plain amount
        return amount;
      }

      // Define visible tiers: min quantity => discount percent and code (product-quantity based)
      var TIERS = [
        { min: 2, discount: 10, code: 'BULK10' },
        { min: 3, discount: 15, code: 'BULK15' },
        { min: 4, discount: 20, code: 'BULK20' }
      ];

      function updateAllMessages(cart) {
        var containers = document.querySelectorAll('.js-cart-bulk-upsell');
        var itemCount = (cart && typeof cart.item_count === 'number') ? cart.item_count : 0;
        var cartTotalCents = (cart && cart.total_price) ? cart.total_price : 0;

        var MAX_TIER_MIN = TIERS[TIERS.length - 1].min;

        function getNextTier(qty) {
          for (var i = 0; i < TIERS.length; i++) {
            if (TIERS[i].min > qty) return TIERS[i];
          }
          return null;
        }

        function getAppliedDiscount(qty) {
          // Highest tier that is <= qty
          for (var i = TIERS.length - 1; i >= 0; i--) {
            if (qty >= TIERS[i].min) return TIERS[i].discount;
          }
          return 0;
        }

        var appliedDiscountPercent = getAppliedDiscount(itemCount);
        var appliedDiscountRate = appliedDiscountPercent / 100;
        var totalSavingsCents = Math.round(cartTotalCents * appliedDiscountRate);
        var perItemSavingsCents = itemCount > 0 ? Math.round((cartTotalCents / itemCount) * appliedDiscountRate) : 0;

        containers.forEach(function (container) {
          var msgEl = container.querySelector('.js-cart-bulk-upsell-message');
          if (!msgEl) return;

          var main = '';
          var secondary = '';
          var savingsHtml = '';

          // For messages, compute the qty of this specific variant in the cart (per-card)
          var variantId = container.getAttribute('data-upsell-variant-id');
          var variantQty = 0;
          if (cart && cart.items && variantId) {
            cart.items.forEach(function (itm) {
              if (String(itm.variant_id) === String(variantId)) variantQty += itm.quantity;
            });
          }

          if (variantQty < MAX_TIER_MIN) {
            var next = getNextTier(variantQty);
            if (next) {
              var missing = next.min - variantQty;
              var bagWord = missing === 1 ? 'bag' : 'bags';
              main = 'Add ' + missing + ' more ' + bagWord + ' and get ' + next.discount + '% off this product';
            } else {
              main = 'Add items to unlock discounts';
            }
          } else {
            main = TIERS[TIERS.length - 1].discount + '% off applied to this product';
          }

          // Show per-item + total savings once highest discount applies (4+)
          {% comment %} if (itemCount >= MAX_TIER_MIN && cartTotalCents > 0 && appliedDiscountPercent > 0) {
            savingsHtml = '<div class="cart-bulk-upsell__savings-wrap" role="status" aria-live="polite">';
            savingsHtml += '<strong class="cart-bulk-upsell__savings-total">You save ' + formatMoney(totalSavingsCents) + '</strong>';
            savingsHtml += ' <span class="cart-bulk-upsell__savings-per">(' + formatMoney(perItemSavingsCents) + ' per bag)</span>';
            savingsHtml += '</div>';
          } {% endcomment %}

          var html = '<span class="cart-bulk-upsell__message-main">' + main + '</span>';
          if (savingsHtml) html += '<br>' + savingsHtml;
          if (secondary) {
            html += '<br><small class="cart-bulk-upsell__secondary">' + secondary + '</small>';
          }

          msgEl.innerHTML = html;
        });
      }

    // Helper to get desired discount code for a qty
    function desiredDiscountCode(qty) {
      var code = null;
      for (var i = TIERS.length - 1; i >= 0; i--) {
        if (qty >= TIERS[i].min) {
          code = TIERS[i].code;
          break;
        }
      }
      return code;
    }

      function fetchCartAndUpdate() {
        // Use Shopify's cart endpoint to get live cart state
        fetch('/cart.js', { credentials: 'same-origin' })
          .then(function (res) { return res.json(); })
          .then(function (cart) {
            updateAllMessages(cart);
          })
          .catch(function (err) {
            // If fetch fails, try to use the existing cart object if present
            if (window.cart) {
              updateAllMessages(window.cart);
            } else {
              console.warn('Cart bulk upsell: unable to fetch cart', err);
            }
          });
      }

      function onUpsellClick(e) {
        var btn = e.target.closest && e.target.closest('.js-cart-bulk-upsell-add');
        if (!btn) return;
        e.preventDefault();
        var container = btn.closest('.cart-bulk-upsell');
        if (!container) return;
        var variantId = container.getAttribute('data-upsell-variant-id');
        if (!variantId) return;

        btn.disabled = true;
        WAU.ThemeCart.addItem(parseInt(variantId, 10), { quantity: 1 })
          .then(function () {
            // After adding, refresh messages briefly (in case cart drawer updated via AJAX)
            fetchCartAndUpdate();
            // Navigate to cart page so the cart is fully refreshed
            if (document.documentElement.lang === "nl") {
              window.location.href = "/nl/cart";
            } else if (document.documentElement.lang === "de") {
              window.location.href = "/de/cart";
            } else {
              window.location.href = "/cart";
            }
          })
          .catch(function (err) {
            console.error('Cart bulk upsell add error', err);
            btn.disabled = false;
          });
      }

      // Initialize: delegate click handler once and update messages on load.
      if (!document.body.dataset.bulkUpsellDelegation) {
        document.addEventListener('click', onUpsellClick, false);
        document.body.dataset.bulkUpsellDelegation = 'true';
      }

      document.addEventListener('DOMContentLoaded', function () {
        fetchCartAndUpdate();
      });

      // Also update when Shopify sections are reloaded/selected (AJAX theme events)
      document.addEventListener('shopify:section:load', fetchCartAndUpdate);
      document.addEventListener('shopify:section:select', fetchCartAndUpdate);
    })();
  </script>
  <script>
    // Prevent built-in WAU.CartUpsell from overwriting our custom messaging
    document.addEventListener('DOMContentLoaded', function () {
      if (window.WAU && WAU.CartUpsell) {
        // Keep originals in case we need to restore later
        WAU.CartUpsell.__original = {
          init: WAU.CartUpsell.init,
          _render: WAU.CartUpsell._render,
          _update: WAU.CartUpsell._update
        };
        WAU.CartUpsell.init = function () { /* noop - custom messaging handles UI */ };
        WAU.CartUpsell._render = function () { /* noop */ };
        WAU.CartUpsell._update = function () { /* noop */ };
      }
    });
  </script>
  <script>
    // Wrap ThemeCart add methods to apply discount codes automatically when thresholds are reached
    document.addEventListener('DOMContentLoaded', function () {
      if (!window.WAU || !WAU.ThemeCart) return;

      function getCartPath() {
        if (document.documentElement.lang === "nl") return "/nl/cart";
        if (document.documentElement.lang === "de") return "/de/cart";
        return "/cart";
      }

      function getCodeForQty(qty) {
        return desiredDiscountCode(qty);
      }

      // Wrap addItem
      if (typeof WAU.ThemeCart.addItem === 'function' && !WAU.ThemeCart.__addItemWrapped) {
        WAU.ThemeCart.__addItemWrapped = WAU.ThemeCart.addItem;
        WAU.ThemeCart.addItem = function (id, options) {
          return WAU.ThemeCart.__addItemWrapped(id, options).then(function (res) {
            return WAU.ThemeCart.getCart().then(function (cart) {
              try {
                // compute quantity of this specific variant in the updated cart
                var variantQty = 0;
                if (cart && cart.items) {
                  cart.items.forEach(function (itm) {
                    if (String(itm.variant_id) === String(id)) variantQty += itm.quantity;
                  });
                }
                var code = getCodeForQty(variantQty);
                if (code && window.location.search.indexOf('discount=' + code) === -1) {
                  window.location.href = getCartPath() + '?discount=' + code;
                }
              } catch (e) {
                // ignore
              }
              return res;
            });
          });
        };
      }

      // Wrap addItemFromForm
      if (typeof WAU.ThemeCart.addItemFromForm === 'function' && !WAU.ThemeCart.__addItemFromFormWrapped) {
        WAU.ThemeCart.__addItemFromFormWrapped = WAU.ThemeCart.addItemFromForm;
        WAU.ThemeCart.addItemFromForm = function (form) {
          return WAU.ThemeCart.__addItemFromFormWrapped(form).then(function (res) {
            return WAU.ThemeCart.getCart().then(function (cart) {
              try {
                // attempt to read variant id from form
                var formEl = form instanceof HTMLFormElement ? form : document.querySelector('form');
                var variantId = null;
                try {
                  var fd = new FormData(formEl);
                  variantId = fd.get('id') || fd.get('variant');
                } catch (e) {}

                var variantQty = 0;
                if (variantId && cart && cart.items) {
                  cart.items.forEach(function (itm) {
                    if (String(itm.variant_id) === String(variantId)) variantQty += itm.quantity;
                  });
                }
                var code = getCodeForQty(variantQty);
                if (code && window.location.search.indexOf('discount=' + code) === -1) {
                  window.location.href = getCartPath() + '?discount=' + code;
                }
              } catch (e) {}
              return res;
            });
          });
        };
      }
    });
  </script>
{%- endif -%}
{%- endif -%}

