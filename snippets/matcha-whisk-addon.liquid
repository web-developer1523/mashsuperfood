{% comment %}
  Matcha Whisk add-on: "Add Whisk +X,XX" for product pages and cart.
  Expects: addon_product (optional Product object), addon_product_handle (product handle – used when all_products doesn't include the product)
{% endcomment %}
{%- assign addon_variant = addon_product.selected_or_first_available_variant -%}
{%- assign addon_thumb_image = addon_variant.featured_media.preview_image | default: addon_variant.image | default: addon_product.featured_image | default: addon_product.images.first -%}
{%- if addon_product != blank and addon_product.available and addon_variant != blank -%}
<div class="matcha-whisk-addon mt3 mb2" data-matcha-whisk-addon>
  <label class="matcha-whisk-addon__label flex v-center">
    <input
      type="checkbox"
      class="matcha-whisk-addon__checkbox"
      name="add_whisk"
      value="{{ addon_variant.id }}"
      data-variant-id="{{ addon_variant.id }}"
    >
    <span class="matcha-whisk-addon__thumb">
      {%- if addon_thumb_image != blank -%}
        {{
          addon_thumb_image
          | image_url: width: 64, height: 64, crop: 'center'
          | image_tag: loading: 'lazy', alt: addon_product.title, class: 'matcha-whisk-addon__thumb-img', width: 32, height: 32
        }}
      {%- else -%}
        <span class="matcha-whisk-addon__thumb-placeholder" aria-hidden="true"></span>
      {%- endif -%}
    </span>
    <span class="matcha-whisk-addon__text">{{ addon_label | default: 'Add premium bamboo Matcha whisk' }} {{ addon_variant.price | money }}</span>
  </label>
</div>
{%- elsif addon_product_handle != blank -%}
<div class="matcha-whisk-addon mt3 mb2" data-matcha-whisk-addon data-product-handle="{{ addon_product_handle | escape }}">
  <label class="matcha-whisk-addon__label flex v-center">
    <input
      type="checkbox"
      class="matcha-whisk-addon__checkbox"
      name="add_whisk"
      data-variant-id=""
      disabled
    >
    <span class="matcha-whisk-addon__thumb">
      <span class="matcha-whisk-addon__thumb-placeholder" aria-hidden="true"></span>
    </span>
    <span class="matcha-whisk-addon__text">{{ addon_label | default: 'Add premium bamboo Matcha whisk' }} <span class="matcha-whisk-addon__price"></span></span>
  </label>
</div>
{%- endif -%}
{%- if addon_product != blank and addon_product.available and addon_variant != blank -%}
<script>
  (function () {
    var container = document.querySelector('[data-matcha-whisk-addon]:not([data-product-handle])');
    if (!container) return;
    var checkbox = container.querySelector('.matcha-whisk-addon__checkbox');
    if (!checkbox) return;

    checkbox.addEventListener('change', function () {
      if (!this.checked) return;
      var variantId = this.getAttribute('data-variant-id');
      if (!variantId) return;
      this.disabled = true;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: parseInt(variantId, 10), quantity: 1 })
      })
        .then(function (res) { return res.json().then(function (data) { return res.ok ? data : Promise.reject(data); }); })
        .then(function () {
          checkbox.checked = true;
          if (typeof window.WAU !== 'undefined' && window.WAU.ThemeCart && typeof window.WAU.ThemeCart.refresh === 'function') {
            window.WAU.ThemeCart.refresh();
          }
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: {} }));
          if (window.location.pathname === '/cart' || window.location.pathname.indexOf('/cart') !== -1) {
            window.location.reload();
          }
        })
        .catch(function (err) {
          console.error('Matcha whisk add-on error', err);
          checkbox.checked = false;
        })
        .finally(function () {
          checkbox.disabled = false;
        });
    });
  })();
</script>
{%- elsif addon_product_handle != blank -%}
<script>
  (function () {
    var container = document.querySelector('[data-matcha-whisk-addon][data-product-handle]');
    if (!container) return;
    var handle = container.getAttribute('data-product-handle');
    if (!handle) return;

    fetch('/products/' + encodeURIComponent(handle) + '.js')
      .then(function (res) {
        return res.json().then(function (data) {
          return res.ok ? data : Promise.reject(data);
        });
      })
      .then(function (product) {
        if (!product || !product.variants || product.variants.length === 0) return;
        var variant = product.variants[0];
        var checkbox = container.querySelector('.matcha-whisk-addon__checkbox');
        var priceEl = container.querySelector('.matcha-whisk-addon__price');
        var thumbWrap = container.querySelector('.matcha-whisk-addon__thumb');
        if (!checkbox || !priceEl) return;

        checkbox.setAttribute('data-variant-id', variant.id);
        checkbox.removeAttribute('disabled');
        var priceFormatted = (variant.price / 100).toFixed(2);
        priceEl.textContent = '€' + priceFormatted.replace('.', ',');
        if (thumbWrap) {
          var imageSrc = '';
          if (variant.featured_image && variant.featured_image.src) {
            imageSrc = variant.featured_image.src;
          } else if (typeof product.featured_image === 'string' && product.featured_image) {
            imageSrc = product.featured_image;
          } else if (product.featured_image && product.featured_image.src) {
            imageSrc = product.featured_image.src;
          } else if (product.images && product.images.length > 0) {
            imageSrc = typeof product.images[0] === 'string' ? product.images[0] : (product.images[0].src || '');
          }

          if (imageSrc) {
            thumbWrap.innerHTML = '<img class="matcha-whisk-addon__thumb-img" src="' + imageSrc + '" alt="Matcha whisk" width="32" height="32">';
          }
        }

        checkbox.addEventListener('change', function () {
          if (!this.checked) return;
          var variantId = this.getAttribute('data-variant-id');
          if (!variantId) return;
          this.disabled = true;

          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: parseInt(variantId, 10), quantity: 1 })
          })
            .then(function (res) { return res.json().then(function (data) { return res.ok ? data : Promise.reject(data); }); })
            .then(function () {
              checkbox.checked = true;
              if (typeof window.WAU !== 'undefined' && window.WAU.ThemeCart && typeof window.WAU.ThemeCart.refresh === 'function') {
                window.WAU.ThemeCart.refresh();
              }
              document.dispatchEvent(new CustomEvent('cart:updated', { detail: {} }));
              if (window.location.pathname === '/cart' || window.location.pathname.indexOf('/cart') !== -1) {
                window.location.reload();
              }
            })
            .catch(function (err) {
              console.error('Matcha whisk add-on error', err);
              checkbox.checked = false;
            })
            .finally(function () {
              checkbox.disabled = false;
            });
        });
      })
      .catch(function (err) {
        var priceEl = container.querySelector('.matcha-whisk-addon__price');
        if (priceEl) priceEl.textContent = '';
        console.error('Matcha whisk addon fetch error', err);
      });
  })();
</script>
{%- endif -%}
<style>
  .matcha-whisk-addon__label {
    cursor: pointer;
    gap: 10px;
    display: flex;
    align-items: center;
  }
  .matcha-whisk-addon__checkbox {
    width: 15px;
    height: 15px;
  }
  .matcha-whisk-addon__checkbox:disabled {
    cursor: not-allowed;
  }
  .matcha-whisk-addon__text {
    font-weight: 500;
    text-transform: capitalize;
  }
  .matcha-whisk-addon__thumb {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
  }
  .matcha-whisk-addon__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .matcha-whisk-addon__thumb-placeholder {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>