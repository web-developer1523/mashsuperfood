{% comment %}
  snippets/product-buttons.liquid

  Accompanies the main-product.liquid and featured-product.liquid theme files.

  Accepts:
    - product: {Object} Product Liquid object
    - type: {Object} Section Liquid object
    - product_type: {String} Either 'product' or 'featured_product'
    - current_variant: {Object} Variant Liquid object
    - product_form_config: {Object} Liquid object
    - call_to_action: {String} String for "Add to cart" button
    - show_price_in_button: {Boolean} Boolean setting
    - show_gift_card_recipient: {Boolean} Boolean setting
    - secondary_button: {String}
    - product_info_align: {String} ??


  Usage:
  {%
    render 'product-buttons',
    product: product,
    type: section,
    product_type: 'product',
    current_variant: current_variant,
    product_form_config: product_form_config,
    call_to_action: call_to_action,
    show_price_in_button: block.settings.show_price_in_button,
    show_gift_card_recipient: block.settings.show_gift_card_recipient
  %}
{% endcomment %}
{%- liquid

  assign product_form_id = 'product-buttons-form-' | append: section.id
  assign whisk_addon_allowed_ids = '10164012548423' | split: ','

-%}

{% form 'product', product,
   id: product_form_id,
   class: "product__form-container product_form js-prod-form-submit",
   data-product-form: product_form_config,
   data-product-id: product.id %}


   {% capture price %}
     <span data-regular-price>
       {{ current_variant.price | money }}
     </span>

     <span class="hide" data-compare-text>
       {{ 'products.product.regular_price' | t }}
     </span>
     <span class="strike ml1" data-compare-price>
       {% if product.compare_at_price_max > product.price %}
         {% if current_variant.compare_at_price > current_variant.price %}
           {{ current_variant.compare_at_price | money }}
         {% endif %}
       {% endif %}
     </span>
   {% endcapture %}

   <input class="formQty" type="hidden" name="quantity" value="1" />

  <div class="product__add-container mt4">

    {% if show_gift_card_recipient and product.gift_card? %}
      {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
    {%- endif -%}

    <input id="formVariantId" name="id"  type="hidden" value="{{ product.selected_or_first_available_variant.id }}">
    <div class="note note-success mt3 js-added-msg a-center mb4" style="display: none">
      <strong>{{ 'products.product.added' | t }}</strong> <a class="underline" href="{{ routes.cart_url }}">{{ 'products.product.view_cart' | t }}</a> {{ 'products.product.or' | t }} <a class="underline" href="{{ routes.all_products_collection_url }}">{{ 'products.product.continue' | t }}</a>.
    </div>
    <div class="note note-error js-error-msg a-center mb4" style="display: none">
      <strong>{{ 'cart.general.cart_error' | t }}</strong> {{ 'cart.general.update_qty_error' | t }}
    </div>

    {% assign current_product_id = product.id | append: '' %}
    {% if whisk_addon_handle != blank and whisk_addon_allowed_ids contains current_product_id %}
      {% render 'matcha-whisk-addon', addon_product: whisk_addon_product, addon_product_handle: whisk_addon_handle, addon_label: whisk_addon_label %}
    {% endif %}

    <button
     type="submit"
     name="add"
     data-variant-id="{{ current_variant.id }}"
     class="ajax-submit js-ajax-submit add-item add btn-outline {{ secondary_button }} w100"
     {% unless current_variant.available %}disabled="disabled"{% endunless %}>
        {% if show_price_in_button %}
          {{ price }}
          <span class="button--content--separator ml1">—</span>
        {% endif %}
         <span data-add-to-cart-text>
           {{ call_to_action }}
           <svg style="margin-top: -2px;" xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" viewBox="0 0 16 16" fill="#f2eee6" class="bi bi-arrow-right-short">
            <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8z"></path>
          </svg>
         </span>

     </button>

    {% if settings.product_show_payment_button %}
      <div class="product-additional-buttons mb2">
        {{ form | payment_button }}
      </div>
    {% endif %}
  </div>
{% endform %}
<style>

  button.ajax-submit.js-ajax-submit svg {
    fill: #f2eee6;
}
  button.ajax-submit.js-ajax-submit {
    font-weight: 600;
}
  .product__add-container {
    display: flex;
    flex-direction: column;
  }
  input#formVariantId{
    order: 1;
  }
  .note.note-success {
    order: 2;
}
.note.note-error {
  order: 3;
}
div#appstle_subscription_widget0 {
  order: 4;
}
.matcha-whisk-addon {
  order: 2;
  {% comment %} margin-bottom: 20px; {% endcomment %}
}
button.ajax-submit.js-ajax-submit {
  order: 6;
}
.product-additional-buttons.mb2 {
  order: 7;
}
.product-template .product__section-right .product-block--price {
  display: none;
}
@media only screen and (max-width: 575px) {
  html.js[lang="de"] button.ajax-submit.js-ajax-submit{
    display: inline-flex;
  }
  html.js[lang="nl"] button.ajax-submit.js-ajax-submit{
    display: inline-block;
  }
  span[data-add-to-cart-text] {
    text-align: right;
    max-width: 100% !important;
    display: inline-block;
    align-items: center;
    line-height: inherit;
  } 
}

</style>